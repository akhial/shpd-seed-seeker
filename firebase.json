{
  "hosting": {
    "public": "web/public",
    "ignore": ["**/.DS_Store", "_headers", "third_party/**"],
    "redirects": [
      {"source": "/", "destination": "https://shpd-seed-seeker.pages.dev/", "type": 301},
      {"regex": "^/(?P<path>[^.].*)$", "destination": "https://shpd-seed-seeker.pages.dev/:path", "type": 301}
    ]
  }
}
